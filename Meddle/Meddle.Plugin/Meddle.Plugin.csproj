<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>0.0.1</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Meddle.Plugin</RootNamespace>
        <LangVersion>14</LangVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
        <!-- Keep the lock file compatible with VS2022's NuGet, which does
             not support .NET 10 package pruning. -->
        <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
        <MeddleCommit>$(MeddleCommitOverride)</MeddleCommit>
        <MeddleDirty>$(MeddleDirtyOverride)</MeddleDirty>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.1" />       
        <Reference Include="OtterTex">
            <HintPath>..\Meddle.Utils\Lib\OtterTex.dll</HintPath>
        </Reference>
        <PackageReference Update="DalamudPackager" Version="15.0.0" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization/*.json" />
        <ProjectReference Include="..\Meddle.Utils\Meddle.Utils.csproj"/>
        <ProjectReference Include="..\Meddle.Formats\Meddle.Formats.csproj"/>
        <ProjectReference Include="..\Meddle.SqPack\Meddle.SqPack.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\third_party\UAssetAPI\LICENSE" Link="UAssetAPI.LICENSE" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <Use_Custom_ClientStructs>false</Use_Custom_ClientStructs>
        <CustomClientStructsPath>..\..\..\FFXIVClientStructs</CustomClientStructsPath>
    </PropertyGroup>
    <ItemGroup Condition="$(Use_Custom_ClientStructs) == false">
        <Reference Include="InteropGenerator.Runtime" Private="false" />
        <Reference Include="FFXIVClientStructs" Private="false" />
    </ItemGroup>
    <PropertyGroup Condition="$(Use_Custom_ClientStructs) == true">
        <Use_Dalamud_FFXIVClientStructs>false</Use_Dalamud_FFXIVClientStructs>
        <InteropGenerator_InteropNamespace>MeddlePlugin</InteropGenerator_InteropNamespace>
        <DefineConstants>HAS_LOCAL_CS</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="$(Use_Custom_ClientStructs) == true">
        <CompilerVisibleProperty Include="InteropGenerator_InteropNamespace" />
        <ProjectReference Include="$(CustomClientStructsPath)\InteropGenerator\InteropGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="$(CustomClientStructsPath)\FFXIVClientStructs\FFXIVClientStructs.csproj" Private="True" />
        <ProjectReference Include="$(CustomClientStructsPath)\InteropGenerator.Runtime\InteropGenerator.Runtime.csproj" Private="True" />
    </ItemGroup>

    <UsingTask TaskName="CaptureGitProvenance" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <WorkingDirectory ParameterType="System.String" Required="true" />
            <GitCommand ParameterType="System.String" Required="true" />
            <StdOut ParameterType="System.String" Output="true" />
            <ExitCode ParameterType="System.Int32" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.Diagnostics" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                StdOut = string.Empty;
                ExitCode = -1;
                try
                {
                    var startInfo = new ProcessStartInfo("git", GitCommand)
                    {
                        WorkingDirectory = WorkingDirectory,
                        RedirectStandardOutput = true,
                        RedirectStandardError = true,
                        UseShellExecute = false,
                        CreateNoWindow = true
                    };

                    using var process = Process.Start(startInfo);
                    if (process != null)
                    {
                        var stdoutTask = process.StandardOutput.ReadToEndAsync();
                        var stderrTask = process.StandardError.ReadToEndAsync();
                        process.WaitForExit();
                        System.Threading.Tasks.Task.WaitAll(stdoutTask, stderrTask);

                        StdOut = stdoutTask.Result.Trim();
                        ExitCode = process.ExitCode;
                    }
                }
                catch
                {
                    StdOut = string.Empty;
                    ExitCode = -1;
                }
                ]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="CaptureBuildProvenance" BeforeTargets="GenerateAssemblyInfo" Condition="'$(DesignTimeBuild)' != 'true'">
        <CaptureGitProvenance
            WorkingDirectory="$(MSBuildProjectDirectory)/../.."
            GitCommand="rev-parse HEAD"
            Condition="'$(MeddleCommit)' == ''">
            <Output TaskParameter="StdOut" PropertyName="MeddleGitCommitRaw" />
            <Output TaskParameter="ExitCode" PropertyName="MeddleGitCommitExitCode" />
        </CaptureGitProvenance>
        <CaptureGitProvenance
            WorkingDirectory="$(MSBuildProjectDirectory)/../.."
            GitCommand="status --porcelain --untracked-files=normal"
            Condition="'$(MeddleDirty)' == ''">
            <Output TaskParameter="StdOut" PropertyName="MeddleGitStatusRaw" />
            <Output TaskParameter="ExitCode" PropertyName="MeddleGitStatusExitCode" />
        </CaptureGitProvenance>
        <PropertyGroup>
            <MeddleCommit Condition="'$(MeddleCommit)' == '' and '$(MeddleGitCommitExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(MeddleGitCommitRaw)', '^[0-9a-fA-F]{40,64}$'))">$(MeddleGitCommitRaw)</MeddleCommit>
            <MeddleDirty Condition="'$(MeddleDirty)' == '' and '$(MeddleGitStatusExitCode)' == '0' and '$(MeddleGitStatusRaw)' != ''">true</MeddleDirty>
            <MeddleDirty Condition="'$(MeddleDirty)' == '' and '$(MeddleGitStatusExitCode)' == '0' and '$(MeddleGitStatusRaw)' == ''">false</MeddleDirty>
            <BuildProvenanceSource><![CDATA[
[assembly: System.Reflection.AssemblyMetadata("MeddleBuildVersion", "$(Version)")]
[assembly: System.Reflection.AssemblyMetadata("MeddleBuildCommit", "$(MeddleCommit)")]
[assembly: System.Reflection.AssemblyMetadata("MeddleBuildDirty", "$(MeddleDirty)")]
]]></BuildProvenanceSource>
        </PropertyGroup>
        <WriteLinesToFile
            File="$(IntermediateOutputPath)BuildProvenance.g.cs"
            Lines="$(BuildProvenanceSource)"
            Overwrite="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildProvenance.g.cs" />
        </ItemGroup>
    </Target>
</Project>
